{
  "$schema": "https://typedoc.org/schema.json",

  "entryPoints": ["src"],
  "entryPointStrategy": "expand",
  "out": "docs/api",

  "name": "ps.github.io",
  "readme": "none",
  "includeVersion": false,

  "excludePrivate": false,
  "excludeProtected": false,
  "excludeInternal": true,

  "validation": {
    "notExported": false,
    "invalidLink": true,
    "notDocumented": true
  },

  "treatWarningsAsErrors": true,
  "categorizeByGroup": true
}
